{
  "name": "@aep/dashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "prebuild": "pnpm --filter @aep/shared build && pnpm --filter @aep/event-model build",
